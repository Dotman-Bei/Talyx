{
  "name": "talyx-prover",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Builds and checks Portaldot V3 BEEFY, MMR, header and Revive storage proofs for Talyx.",
  "bin": {
    "talyx": "./src/cli.ts"
