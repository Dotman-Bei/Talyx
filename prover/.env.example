# A funded testnet key: Sepolia ETH to deploy, import and claim; tPOT on V3 to deploy FillBook and fill.
# Never a mainnet key. This file is .env.example; copy it to .env, which git ignores.
TALYX_PRIVATE_KEY=

# Filled in after deployment (deployments/testnet.json records them too)
TALYX_FILLBOOK=
TALYX_STATE_ROOTS=
TALYX_ESCROW=

# Endpoints (defaults shown)
TALYX_V3_WS=wss://test-node-v3.portaldot.dev
TALYX_V3_EVM_RPC=https://test-evm-rpc-v3.portaldot.dev
TALYX_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
